<Window x:Class="Northpass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Northpass — DPI Control" Width="960" Height="740"
        MinWidth="830" MinHeight="660" WindowStartupLocation="CenterScreen"
        Background="#0D1014" Foreground="#F0F2F4" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="BorderBrush" Color="#2C333C"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#171C22"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E9EDF1"/>
      <Setter Property="Background" Value="#2C343E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.83"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#E6EAEE"/>
      <Setter Property="Background" Value="#11161C"/>
      <Setter Property="BorderBrush" Value="#353D48"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#11161C"/>
      <Setter Property="Background" Value="#E9EDF1"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Window.Resources>

  <Grid Margin="30,26,30,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="66"/>
      <RowDefinition Height="178"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="212"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel Orientation="Vertical">
        <TextBlock Text="NORTHPASS" FontSize="23" FontWeight="Bold"/>
        <TextBlock Text="DPI CONTROL  /  WINDOWS" Foreground="#88929E" FontSize="10" Margin="1,4,0,0"/>
      </StackPanel>
      <TextBlock Text="ENGINE ADAPTER · 0.1" Foreground="#88929E" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8B929A" Margin="0,0,10,0"/>
            <TextBlock x:Name="StatusText" Text="Не запущен" FontSize="21" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Text="Управление движком Zapret2" Foreground="#9BA5AF" Margin="0,15,0,0" FontSize="13"/>
          <TextBlock x:Name="ProfileDescription" Text="Выберите профиль и настройте аргументы." Foreground="#7F8995" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="StartButton" Content="Включить" Background="#CAD6D0" Foreground="#111A16" FontWeight="Bold" Height="48" Click="Start_Click"/>
          <Button x:Name="StopButton" Content="Выключить" Margin="0,10,0,0" Height="43" IsEnabled="False" Click="Stop_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="45"/><RowDefinition Height="12"/><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="КОНФИГУРАЦИЯ" FontSize="11" FontWeight="SemiBold" Foreground="#AAB3BE"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="99"/></Grid.ColumnDefinitions>
          <TextBlock Text="Движок" VerticalAlignment="Center" Foreground="#C9D0D8"/>
          <TextBox Grid.Column="1" x:Name="EnginePathBox" VerticalContentAlignment="Center" ToolTip="Укажите официальный winws2.exe"/>
          <Button Grid.Column="2" Content="Обзор..." Margin="10,0,0,0" Click="Browse_Click"/>
        </Grid>
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
          <TextBlock Text="Профиль" VerticalAlignment="Center" Foreground="#C9D0D8"/>
          <ComboBox Grid.Column="1" x:Name="ProfileCombo" VerticalContentAlignment="Center" SelectionChanged="ProfileCombo_SelectionChanged"/>
          <Button Grid.Column="2" Content="Обновить" Margin="10,0,0,0" Click="ReloadProfiles_Click"/>
        </Grid>
        <TextBlock Grid.Row="4" Text="Профили редактируются в папке profiles (JSON). Никакие стратегии не включены по умолчанию." Foreground="#798590" FontSize="11" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
      </Grid>
    </Border>

    <Border Grid.Row="5" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <TextBlock Text="ЖУРНАЛ РАБОТЫ" FontWeight="SemiBold" FontSize="11" Foreground="#AAB3BE"/>
          <Button Content="Очистить" HorizontalAlignment="Right" Padding="10,5" FontSize="11" Margin="0,-7,0,7" Click="ClearLogs_Click"/>
        </Grid>
        <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontSize="12" Background="#101419" BorderThickness="0"/>
      </Grid>
    </Border>

    <Grid Grid.Row="6">
      <TextBlock Text="Локальная работа · без VPN-сервера · временный движок Zapret2" Foreground="#77828E" FontSize="11" VerticalAlignment="Bottom"/>
      <TextBlock Text="Northpass is an independent wrapper, not an official Zapret2 build" Foreground="#6E7884" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
  </Grid>
</Window>
