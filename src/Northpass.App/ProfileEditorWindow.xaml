<Window x:Class="Northpass.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Northpass · Strategy editor" Width="760" Height="580" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#11161C" Foreground="#E9EDF1">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="JSON profile · one --option=value argument per array item. Empty drafts may be saved.&#10;Id is fixed when editing. File placeholders: {ENGINE_DIR} and {PROFILE_DIR}." TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#A4AFBC"/>
    <TextBox Grid.Row="1" Text="{Binding Json, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0D1117" Foreground="#E9EDF1" Padding="12"/>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="#DC998D" TextWrapping="Wrap" Margin="0,12"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Save profile" Command="{Binding SaveCommand}" Padding="20,10" Margin="0,0,10,0"/>
      <Button Content="Cancel" IsCancel="True" Padding="20,10"/>
    </StackPanel>
  </Grid>
</Window>
