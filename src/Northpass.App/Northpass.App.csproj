<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Northpass.ico</ApplicationIcon>
    <AssemblyName>Northpass</AssemblyName>
    <RootNamespace>Northpass</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Services/WindowsInstallationSecurity.cs" />
    <ProjectReference Include="../Northpass.Broker.Shared/Northpass.Broker.Shared.csproj" />
    <EmbeddedResource Include="../../dist/broker-manifest.json" Condition="Exists('../../dist/broker-manifest.json')" LogicalName="Northpass.Broker.Manifest" />
    <Resource Include="Assets/Northpass.ico" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <ProjectReference Include="../Northpass.Services/Northpass.Services.csproj" />
    <ProjectReference Include="../Northpass.Engine.Zapret1/Northpass.Engine.Zapret1.csproj" />
    <ProjectReference Include="../Northpass.Engine.Native/Northpass.Engine.Native.csproj" />
    <None Include="../../dist/native/native-offline.zip" Condition="Exists('../../dist/native/native-offline.zip')" Link="engine-payload/native-offline.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../dist/Northpass/engine-payload/flowseal-offline.zip" Condition="Exists('../../dist/Northpass/engine-payload/flowseal-offline.zip')" Link="engine-payload/flowseal-offline.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="../../profiles/*.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/licenses/*" Link="docs/licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
