<Window x:Class="Northpass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:Northpass.Presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Northpass" Width="1100" Height="800" MinWidth="900" MinHeight="700" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="#0C0C0E" Foreground="#F0F0F2" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        Icon="Assets/Northpass.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="76" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid Margin="32" motion:Motion.Enter="True">
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Border Width="42" Height="42" Background="#E3E3EB" CornerRadius="12" Margin="0,0,14,0"><Image Source="{StaticResource NorthpassMark}" Margin="4" AutomationProperties.Name="Northpass logo"/></Border>
        <StackPanel><TextBlock Text="NORTHPASS" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Strings[Tagline]}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="{Binding Strings[Minimize]}" AutomationProperties.Name="{Binding Strings[Minimize]}" Click="Minimize_Click"/>
        <Button Style="{StaticResource TitleButton}" Content="&#xE922;" ToolTip="{Binding Strings[Maximize]}" AutomationProperties.Name="{Binding Strings[Maximize]}" Click="Maximize_Click"/>
        <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" ToolTip="{Binding Strings[Close]}" AutomationProperties.Name="{Binding Strings[Close]}" Click="Close_Click"/>
      </StackPanel>
    </Grid>
    <TabControl x:Name="NavigationTabs" Grid.Row="1" SelectedIndex="{Binding PageIndex}" SelectionChanged="Navigation_SelectionChanged">
      <TabItem Header="{Binding Strings[Dashboard]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding Strings[Hero]}" FontSize="36" FontWeight="SemiBold" LineHeight="43" Margin="0,0,0,24"/>
            <Border Style="{StaticResource Card}" Padding="28,24">
              <StackPanel>
                <TextBlock Text="{Binding Strings[CurrentSession]}" Foreground="#858592" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,10,0"/><TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding SessionDuration}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding Strings[Strategy]}" Style="{StaticResource Muted}" FontSize="12"/>
                <ComboBox x:Name="HomeStrategySelector" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" DisplayMemberPath="Label" IsEnabled="{Binding CanConfigure}" ToolTip="{Binding Strings[StrategyHint]}" AutomationProperties.Name="{Binding Strings[Strategy]}" Margin="0,8,0,16"/>
                <Button x:Name="ConnectionButton" Command="{Binding ConnectCommand}" Background="#E7E7ED" Foreground="#141419" FontSize="16" FontWeight="SemiBold" Padding="32,17" HorizontalAlignment="Stretch" Margin="0,0,0,14" AutomationProperties.Name="{Binding ConnectText}"><StackPanel Orientation="Horizontal">
                  <Path Data="M9,1 L9,9 M4,3 A8,8 0 1 0 14,3" Stroke="#24242B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ConnectText}" VerticalAlignment="Center"/>
                </StackPanel></Button>
                <TextBlock Text="{Binding ConnectionNote}" Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center"/>
                <StackPanel Visibility="{Binding Preparing, Converter={StaticResource VisibleWhenTrue}}" Margin="0,16,0,0"><TextBlock Text="{Binding EngineSetupText}" Style="{StaticResource Muted}" Margin="0,0,0,8"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding EngineSetupProgress, Mode=OneWay}" Height="4"/></StackPanel>
              </StackPanel>
            </Border>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="14" Height="14" Margin="0,0,9,0" Visibility="{Binding DiagnosticsRunning, Converter={StaticResource VisibleWhenTrue}}" motion:Motion.Spin="{Binding DiagnosticsRunning}"><Ellipse Stroke="#393940" StrokeThickness="1.5"/><Path Data="M7,1 A6,6 0 0 1 13,7" Stroke="#D0D0DB" StrokeThickness="1.5" StrokeStartLineCap="Round"/></Grid><TextBlock Text="{Binding QuickDiagnostics}" Foreground="#D0D0D9" FontSize="13" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Content="{Binding Strings[CheckServices]}" Command="{Binding ServiceProbesCommand}" Padding="12,7" FontSize="12" Margin="8,0,0,0"/></Grid>
            <ItemsControl ItemsSource="{Binding ServiceCards}" ItemTemplate="{StaticResource QuickServiceCard}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
            <TextBlock Text="{Binding Strings[DiagnosticsScope]}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding UserMessage}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="10,0,10,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Strings[Strategies]}" Visibility="{Binding ShowAdvancedTools, Converter={StaticResource VisibleWhenTrue}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Strings[Strategies]}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Strings[AdvancedNote]}" Style="{StaticResource Muted}" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="{Binding ProfileDescription}" Margin="0,0,0,16"/>
            <WrapPanel><Button Content="{Binding Strings[Validate]}" Command="{Binding ValidateCommand}"/><Button Content="{Binding Strings[Export]}" Command="{Binding ExportCommand}"/><Button Content="{Binding Strings[Refresh]}" Command="{Binding RefreshProfilesCommand}"/></WrapPanel>
            <TextBlock Text="{Binding ResultText}" Margin="0,8,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanConfigure}">
            <TextBlock Text="{Binding Strings[GamePorts]}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding Strings[GamePortsNote]}" Style="{StaticResource Muted}" Margin="0,8,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding GameTcpPorts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="TCP ports" Margin="0,0,12,0"/><TextBox Grid.Column="1" Text="{Binding GameUdpPorts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="UDP ports"/></Grid>
            <TextBlock Text="{Binding Strings[DataLists]}" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <TextBlock Text="{Binding Strings[DataListNote]}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
            <WrapPanel><ComboBox ItemsSource="{Binding ListKinds}" SelectedItem="{Binding ImportListKind}" Width="120" Margin="0,0,12,12"/><Button Content="{Binding Strings[Import]}" Command="{Binding ImportListCommand}"/></WrapPanel>
            <TextBlock Text="{Binding Strings[GeneralHosts]}" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding HostLists}" SelectedValue="{Binding GeneralListId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,8,0,12"/>
            <TextBlock Text="{Binding Strings[ExcludedHosts]}" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding HostLists}" SelectedValue="{Binding ExcludedHostsId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,8,0,12"/>
            <TextBlock Text="{Binding Strings[ExcludedIps]}" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding IpLists}" SelectedValue="{Binding ExcludedIpsId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,8,0,12"/>
            <TextBlock Text="{Binding Strings[AllIps]}" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding IpLists}" SelectedValue="{Binding AllIpsId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,8,0,12"/>
            <Button Content="{Binding Strings[SaveInputs]}" Command="{Binding SaveInputsCommand}" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="{Binding Strings[Provider]}" Style="{StaticResource Muted}"/>
            <TextBox Text="{Binding ProviderLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,8,0,12"/>
            <WrapPanel><Button Content="{Binding Strings[GuidedTest]}" Command="{Binding TestStrategyCommand}"/><Button Content="{Binding Strings[Cancel]}" Command="{Binding CancelTestCommand}"/><Button Content="{Binding Strings[NextStrategy]}" Command="{Binding NextStrategyCommand}"/></WrapPanel>
            <TextBlock Text="{Binding ServiceResults}" Margin="0,12,0,12"/>
            <WrapPanel><Button Content="{Binding Strings[PlaybackPassed]}" Command="{Binding ReportPlaybackPassedCommand}"/><Button Content="{Binding Strings[PlaybackFailed]}" Command="{Binding ReportPlaybackFailedCommand}"/><Button Content="{Binding Strings[VoicePassed]}" Command="{Binding ReportVoicePassedCommand}"/><Button Content="{Binding Strings[VoiceFailed]}" Command="{Binding ReportVoiceFailedCommand}"/></WrapPanel>
          </StackPanel></Border>
          <TextBox Text="{Binding ProfilesDirectory, Mode=OneWay}" IsReadOnly="True"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Strings[Diagnostics]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Strings[Diagnostics]}" Style="{StaticResource Heading}"/>
          <TextBlock Text="{Binding QuickDiagnostics}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
          <ItemsControl x:Name="ServiceDiagnosticsCards" ItemsSource="{Binding ServiceCards}" ItemTemplate="{StaticResource QuickServiceCard}" Margin="0,0,0,16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          <TextBlock Text="{Binding Strings[DiagnosticsScope]}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
          <Button Content="{Binding Strings[CheckServices]}" Command="{Binding ServiceProbesCommand}" HorizontalAlignment="Left"/>
          <Expander Header="{Binding Strings[TechnicalDetails]}" Foreground="#D0D0D8" Margin="0,20,0,0">
            <StackPanel Margin="0,16,0,0"><ItemsControl ItemsSource="{Binding ServiceCards}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <WrapPanel><Button Content="{Binding Strings[ExportLogs]}" Command="{Binding ExportLogsCommand}"/><Button Content="{Binding Strings[ClearLogs]}" Command="{Binding ClearLogsCommand}"/></WrapPanel>
              <TextBlock Text="{Binding ResultText}" Margin="0,8,0,16"/>
              <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" Height="260" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged"/>
            </StackPanel>
          </Expander>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Strings[Settings]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Strings[Settings]}" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanConfigure}">
            <TextBlock Text="{Binding Strings[Language]}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding Strings[LanguageHint]}" Style="{StaticResource Muted}" Margin="0,8,0,4"/>
            <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding LanguageChoices}" SelectedValue="{Binding Language, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Code" ItemTemplate="{StaticResource LanguageOption}" Width="260" HorizontalAlignment="Left" Margin="0,12,0,26" AutomationProperties.Name="{Binding Strings[Language]}"/>
            <TextBlock Text="{Binding Strings[Preferences]}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,22"/><CheckBox Content="{Binding Strings[Tray]}" IsChecked="{Binding MinimizeToTray}"/>
            <CheckBox Content="{Binding Strings[AutoStart]}" IsChecked="{Binding StartWithWindows}"/>
            <CheckBox Content="{Binding Strings[Recovery]}" IsChecked="{Binding AutoRecover}"/>
            <CheckBox Content="{Binding Strings[Updates]}" IsChecked="{Binding CheckForUpdates}"/>
            <Button Content="{Binding Strings[Save]}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <Button Content="{Binding Strings[RepairEngine]}" Command="{Binding RepairEngineCommand}" HorizontalAlignment="Left"/>
          <WrapPanel Visibility="{Binding ShowAdvancedTools, Converter={StaticResource VisibleWhenTrue}}"><Button Content="{Binding Strings[UpdateEngine]}" Command="{Binding UpdateEngineCommand}"/><Button Content="{Binding Strings[RollbackEngine]}" Command="{Binding RollbackEngineCommand}"/></WrapPanel>
          <Button Content="{Binding Strings[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left" Visibility="{Binding ShowAdvancedTools, Converter={StaticResource VisibleWhenTrue}}"/>
          <TextBlock Text="{Binding UserMessage}" Margin="0,10,0,20"/>
          <TextBlock Text="{Binding Strings[AutomaticPrivacy]}" Style="{StaticResource Muted}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Strings[About]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <Border Style="{StaticResource Card}"><StackPanel>
            <Border Width="64" Height="64" Background="#E3E3EB" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,20"><Image Source="{StaticResource NorthpassMark}" Margin="5"/></Border>
            <TextBlock Text="Northpass" FontSize="38" FontWeight="SemiBold"/><TextBlock Text="0.7.0 · Windows 10/11" Style="{StaticResource Muted}" Margin="0,8,0,20"/>
            <TextBlock Text="{Binding Strings[AboutProduct]}" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding Strings[AvailabilityNote]}" Style="{StaticResource Muted}"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
            <TextBlock Text="{Binding Strings[SupportTitle]}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="{Binding Strings[SupportInfo]}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
            <Button Content="{Binding Strings[OpenDiagnostics]}" Command="{Binding OpenDiagnosticsCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding AppUpdateText}" Style="{StaticResource Muted}" Margin="0,10,0,14"/><Button Content="{Binding Strings[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <Expander Header="{Binding Strings[Legal]}" Foreground="#B8B8C2" Margin="0,2,0,12"><StackPanel Margin="0,14,0,0"><TextBlock Text="{Binding Strings[LegalInfo]}" Style="{StaticResource Muted}" Margin="0,0,0,12"/><Button Content="{Binding Strings[ViewLicenses]}" Click="Licenses_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="Northpass 0.7" Style="{StaticResource Muted}" FontSize="10" Margin="180,20,0,0"/>
  </Grid>
</Window>
