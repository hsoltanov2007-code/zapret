<Window x:Class="Northpass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Northpass" Width="1100" Height="800" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#11161D" Foreground="#E7ECF2" FontFamily="Segoe UI" FontSize="14"
        Icon="Assets/Northpass.ico">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Border Width="42" Height="42" Background="#CCD9D2" CornerRadius="12" Margin="0,0,14,0"><Viewbox Margin="11"><Path Data="M0,20 L0,0 L5,0 L15,14 L15,0 L20,0 L20,20 L15,20 L5,6 L5,20 Z" Fill="#19231F"/></Viewbox></Border>
        <StackPanel><TextBlock Text="NORTHPASS" FontSize="24" FontWeight="Bold"/><TextBlock Text="WINDOWS · ENGINE CONTROL" Style="{StaticResource Muted}" FontSize="10"/></StackPanel>
      </StackPanel>
      <TextBlock Text="0.3 / DEVELOPMENT" HorizontalAlignment="Right" Foreground="#8291A3" FontSize="11" Margin="0,12,0,0"/>
    </Grid>
    <TabControl x:Name="NavigationTabs" Grid.Row="1" SelectedIndex="{Binding PageIndex}">
      <TabItem Header="{Binding Strings[Dashboard]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding Strings[Dashboard]}" Style="{StaticResource Heading}"/>
            <Border Style="{StaticResource Card}" Padding="32">
              <StackPanel HorizontalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Strings[StateNote]}" Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="450" Margin="0,14,0,24"/>
                <Button Content="{Binding ConnectText}" Command="{Binding ConnectCommand}" Background="#CCD9D2" Foreground="#16231C" FontSize="17" FontWeight="Bold" Padding="56,20" MinWidth="270"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Strings[Engine]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding CurrentEngine}" FontSize="19" Margin="0,6,0,20"/><TextBlock Text="{Binding Strings[Strategy]}" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanConfigure}" DisplayMemberPath="Name" Margin="0,6,20,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Strings[Session]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SessionDuration}" FontSize="19" Margin="0,6,0,20"/><TextBlock Text="{Binding Strings[Reachability]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Reachability}" FontSize="17" Margin="0,8,0,0"/></StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{Binding Strings[EngineSetup]}" Style="{StaticResource Muted}"/>
              <TextBlock Text="{Binding EngineSetupText}" Margin="0,8,0,8"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding EngineSetupProgress, Mode=OneWay}" Height="8"/>
              <TextBlock Text="{Binding EngineRevision}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,12"/>
              <WrapPanel><Button Content="{Binding Strings[SetupEngine]}" Command="{Binding SetupEngineCommand}"/><Button Content="{Binding Strings[RepairEngine]}" Command="{Binding RepairEngineCommand}"/></WrapPanel>
            </StackPanel></Border>
            <TextBlock Text="{Binding ProfileDescription}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding ResultText}" Foreground="#B5C6D7"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Strings[Strategies]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Strings[Strategies]}" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="{Binding Strings[Strategy]}" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanConfigure}" DisplayMemberPath="Name" Margin="0,12,0,16"/>
            <TextBlock Text="{Binding ProfileDescription}" Margin="0,0,0,18"/>
            <WrapPanel><Button Content="{Binding Strings[New]}" Command="{Binding NewProfileCommand}"/><Button Content="{Binding Strings[Edit]}" Command="{Binding EditProfileCommand}"/><Button Content="{Binding Strings[Import]}" Command="{Binding ImportCommand}"/><Button Content="{Binding Strings[Export]}" Command="{Binding ExportCommand}"/><Button Content="{Binding Strings[Refresh]}" Command="{Binding RefreshProfilesCommand}"/></WrapPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="{Binding Strings[EnginePath]}" Style="{StaticResource Muted}"/>
            <Grid Margin="0,12,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding EnginePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/><Button Grid.Column="1" Content="{Binding Strings[Browse]}" Command="{Binding BrowseCommand}" IsEnabled="{Binding CanChooseEngine}" Margin="12,0,0,0"/></Grid>
            <Button Content="{Binding Strings[Validate]}" Command="{Binding ValidateCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ResultText}" Margin="0,12,0,0"/>
          </StackPanel></Border>
          <TextBlock Text="{Binding Strings[ProfileNote]}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <TextBox Text="{Binding ProfilesDirectory, Mode=OneWay}" IsReadOnly="True"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Strings[Diagnostics]}">
        <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Strings[Diagnostics]}" Style="{StaticResource Heading}"/>
          <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Strings[TestUrl]}" Style="{StaticResource Muted}"/>
            <TextBox Text="{Binding DiagnosticUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12"/>
            <WrapPanel><Button Content="{Binding Strings[Test]}" Command="{Binding TestCommand}"/><Button Content="{Binding Strings[ExportLogs]}" Command="{Binding ExportLogsCommand}"/><Button Content="{Binding Strings[ClearLogs]}" Command="{Binding ClearLogsCommand}"/></WrapPanel>
            <TextBlock Text="{Binding ResultText}" Margin="0,8,0,16"/>
          </StackPanel>
          <TextBox Grid.Row="2" x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged"/>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding Strings[Settings]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Strings[Settings]}" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanConfigure}">
            <TextBlock Text="{Binding Strings[Language]}" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="140" HorizontalAlignment="Left" Margin="0,10,0,24"/>
            <CheckBox Content="{Binding Strings[Tray]}" IsChecked="{Binding MinimizeToTray}"/>
            <CheckBox Content="{Binding Strings[AutoStart]}" IsChecked="{Binding StartWithWindows}"/>
            <CheckBox Content="{Binding Strings[Recovery]}" IsChecked="{Binding AutoRecover}"/>
            <CheckBox Content="{Binding Strings[Updates]}" IsChecked="{Binding CheckForUpdates}"/>
            <Button Content="{Binding Strings[Save]}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <WrapPanel><Button Content="{Binding Strings[UpdateEngine]}" Command="{Binding UpdateEngineCommand}"/><Button Content="{Binding Strings[RollbackEngine]}" Command="{Binding RollbackEngineCommand}"/></WrapPanel>
          <Button Content="{Binding Strings[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding ResultText}" Margin="0,10,0,20"/>
          <TextBlock Text="{Binding Strings[Privacy]}" Style="{StaticResource Muted}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Strings[About]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Strings[About]}" Style="{StaticResource Heading}"/>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="NORTHPASS" FontSize="30" FontWeight="Bold" Margin="0,0,0,20"/><TextBlock Text="{Binding Strings[AboutText]}" Margin="0,0,0,20"/><TextBlock Text="{Binding Strings[Licenses]}" Style="{StaticResource Muted}" Margin="0,0,0,20"/><TextBlock Text="{Binding Strings[AvailabilityNote]}" Style="{StaticResource Muted}"/></StackPanel></Border>
          <TextBlock Text="Windows 10/11 x64 · .NET 8 · WPF / MVVM" Style="{StaticResource Muted}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="Northpass · independent software · external Zapret2 engine" Style="{StaticResource Muted}" FontSize="10" Margin="190,20,0,0"/>
  </Grid>
</Window>
